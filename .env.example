# Postgres connection used by packages/db and packages/orchestrator.
# Local machine with Docker Compose: postgresql://mission_control:mission_control_dev@localhost:5432/mission_control
DATABASE_URL=postgresql://mission_control:mission_control_dev@localhost:5432/mission_control

# Required by @anthropic-ai/claude-agent-sdk to run Agent SDK sessions.
ANTHROPIC_API_KEY=
